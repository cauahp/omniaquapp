# Servidor da API
PORT=3000
NODE_ENV=development

# Banco de Dados PostgreSQL (compatível com o docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/omniaqua

# Broker MQTT (compatível com o mosquitto do docker-compose.yml)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=OmniAqua_Backend_Server
MQTT_USERNAME=
MQTT_PASSWORD=

# Tópicos MQTT
MQTT_TOPIC_COMMAND=omniaqua/bombas/comando
MQTT_TOPIC_STATUS=omniaqua/bombas/status
MQTT_TOPIC_LWT=omniaqua/dispositivo/status

# Fuso horário dos agendamentos
TZ_AGENDAMENTOS=America/Recife

